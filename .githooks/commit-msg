#!/bin/sh
# DSH 提交签名钩子：仅在 DSH_COMMIT=1 时追加随机情绪签名
# 安装：git config core.hooksPath .githooks

[ "$DSH_COMMIT" = "1" ] || exit 0

msg_file="$1"
[ -n "$msg_file" ] || exit 0

# 已经有签名就不重复追加
grep -q "^DSH: " "$msg_file" && exit 0

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
sig=$(cd "$repo_root" && node scripts/dsh-signature.mjs 2>/dev/null)
[ -n "$sig" ] || sig="DSH: 🫠 又一次提交"

printf '\n\n%s\n' "$sig" >>"$msg_file"
exit 0
